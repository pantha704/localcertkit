---
import ToolPage from '../layouts/ToolPage.astro';
---

<ToolPage
  title="CSR Decoder — check SANs, key and signature"
  description="Decode a certificate signing request (CSR) in your browser: subject, SANs, requested extensions, key size, signature algorithm and signature verification. PEM or DER. No upload."
  h1="CSR decoder"
  lead="Read a CSR before you sign it: subject, requested SANs and extensions, public key details, signature algorithm — and whether the CSR’s own signature verifies."
  path="/csr-decoder/"
  toolScript="/js/tools/csr-decoder.js"
  jsonLdName="CSR decoder"
  jsonLdDescription="Decode a PKCS#10 certificate signing request in the browser: subject, SANs, extensions, key info, signature algorithm and signature verification."
  faq={[
    {
      q: 'What is checked automatically?',
      a: 'The CSR signature is verified against its own public key — that proves the request was signed by the private key that matches the included public key. Nothing else is trusted or verified.',
    },
    {
      q: 'What does a valid CSR signature tell me?',
      a: 'It tells you the request is internally consistent: whoever created it held the private key at signing time. It does not tell you who they are — that is the CA’s job.',
    },
    {
      q: 'Can I decode an EC key CSR?',
      a: 'Not in v1 — CertKit parses RSA objects only and reports a friendly unsupported error. EC support is the first item on the roadmap.',
    },
    {
      q: 'Is the CSR uploaded anywhere?',
      a: 'No. The request is parsed by JavaScript in this tab. There are no network calls in the flow — verifiable in DevTools → Network.',
    },
  ]}
>
  <div id="tool-error" class="alert alert-error" role="alert" hidden></div>
  <div id="tool-status" class="visually-hidden" role="status"></div>

  <form id="tool-form" class="card" novalidate>
    <h2>Certificate signing request</h2>
    <div class="file-drop" data-dropzone>
      <label class="field-label" for="csr-file">
        CSR file
        <span class="hint">.csr, .pem or .der — drag &amp; drop, or choose</span>
      </label>
      <input type="file" id="csr-file" accept=".csr,.pem,.der,.txt" />
    </div>
    <div class="field">
      <label for="csr-input">
        or paste PEM / base64 DER
        <span class="hint">A file wins if both are provided.</span>
      </label>
      <textarea id="csr-input" class="mono" spellcheck="false" rows="8" placeholder="-----BEGIN CERTIFICATE REQUEST-----"></textarea>
    </div>
    <div class="btn-row">
      <button type="submit" class="btn" id="csr-run">Decode CSR</button>
    </div>
  </form>

  <section id="results" class="card" aria-labelledby="results-heading" hidden>
    <div class="result-head">
      <h2 id="results-heading">Decoded signing request</h2>
      <span id="sig-badge" class="badge badge-neutral">signature not checked</span>
    </div>

    <div class="btn-row">
      <div class="seg" role="group" aria-label="View">
        <button type="button" id="view-human" data-pane="human" aria-pressed="true">Human-readable</button>
        <button type="button" id="view-json" data-pane="json" aria-pressed="false">Raw JSON</button>
      </div>
    </div>

    <div id="pane-human">
      <dl class="summary-dl" id="csr-summary"></dl>
      <h3>Subject alternative names (requested)</h3>
      <ul id="san-list"></ul>
      <h3>Requested extensions</h3>
      <dl class="summary-dl" id="ext-summary"></dl>
      <div class="out-actions">
        <button type="button" class="btn btn-small btn-secondary" data-copy="out-pem" data-copy-status="copy-status-pem">Copy PEM</button>
        <button type="button" class="btn btn-small btn-secondary" data-download="out-pem" data-filename="request.csr" data-mime="application/x-pem-file">Download PEM</button>
        <span class="small muted" id="copy-status-pem"></span>
      </div>
      <label class="visually-hidden" for="out-pem">CSR PEM</label>
      <textarea id="out-pem" class="mono" readonly spellcheck="false" hidden></textarea>
    </div>

    <div id="pane-json" hidden>
      <h3>ASN.1 as JSON</h3>
      <p class="small muted">Long values are truncated with a byte count.</p>
      <pre id="csr-json" class="raw-json" tabindex="0"></pre>
    </div>
  </section>
</ToolPage>
